# Token bot Discord (WAJIB).
# Dapatkan dari https://discord.com/developers/applications -> Bot -> Reset Token
# JANGAN PERNAH membagikan token ini ke siapapun, termasuk ke AI/chatbot.
DISCORD_TOKEN=

# Client ID aplikasi Discord (opsional untuk menjalankan bot,
# tapi WAJIB diisi saat menjalankan "npm run deploy").
CLIENT_ID=

# ID server Discord untuk testing (opsional).
# Jika diisi -> command didaftarkan sebagai guild command (muncul instan).
# Jika kosong -> command didaftarkan secara global (bisa sampai 1 jam untuk muncul).
GUILD_ID=

# URL stream musik Lofi Chill (opsional, sudah ada default di kode jika dikosongkan).
# Contoh default: SomaFM Groove Salad (radio internet legal, gratis untuk didengarkan).
LOFI_STREAM_URL=https://ice1.somafm.com/groovesalad-128-mp3
